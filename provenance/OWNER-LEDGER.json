{
  "schema": "feisheng-owner-ledger/v1",
  "status": "skeleton",
  "owners": [
    {
      "id": "route-catalog",
      "path": "governance/sliver-core/references/routes-index.md",
      "writes": [
        "primary-route",
        "operation",
        "conditional-lens",
        "reference-loading"
      ],
      "projections": [
        "runtime route JSON",
        "host route hints"
      ]
    },
    {
      "id": "skill-catalog",
      "path": "provenance/CANONICAL-CATALOG.json",
      "writes": [
        "canonical-skill-id",
        "invocation",
        "source",
        "domain",
        "readiness",
        "status",
        "dependencies",
        "outputs"
      ],
      "inputs": [
        "provenance/SKILL-CLASSIFICATION.json",
        "provenance/SKILL-INVENTORY.json",
        "provenance/SKILL-DECISIONS.md"
      ],
      "projections": [
        "README skill lists",
        "plugin manifests",
        "host discovery metadata",
        "docs/CAPABILITY-INDEX.md"
      ]
    },
    {
      "id": "target-truth",
      "path": "docs/target-truth-schema.json",
      "writes": [
        "requirements",
        "plan",
        "terminology",
        "task-state",
        "acceptance-evidence"
      ],
      "adapters": [
        "vibe .vibe-docs.json",
        "Matt issue tracker",
        "project document index"
      ]
    },
    {
      "id": "runtime-projection",
      "path": "packaging/runtime-projection.json",
      "writes": [
        "host-bundle-include",
        "host-overlay",
        "generated-mirror",
        "manifest"
      ],
      "inputs": [
        "provenance/LICENSE-MAP.json"
      ],
      "projections": [
        "Codex",
        "Claude"
      ]
    },
    {
      "id": "local-patch-registry",
      "path": "provenance/LOCAL-PATCHES.json",
      "writes": [
        "local-patch-registration",
        "original-content-hash",
        "patched-content-hash"
      ],
      "inputs": [
        "provenance/PROVENANCE-INTEGRITY.json",
        "sources/",
        "governance/sliver-core/"
      ],
      "projections": [
        "scripts/record-provenance-integrity.ps1",
        "scripts/provenance-integrity.ps1"
      ],
      "rule": "only registered deviations are allowed; unregistered deviation is drift"
    },
    {
      "id": "host-evidence",
      "path": "provenance/HOST-DISCOVERY-EVIDENCE.json",
      "writes": [
        "host-discovery-evidence",
        "model-visible-skill-list",
        "installation-presence"
      ],
      "inputs": [
        "provenance/CANONICAL-CATALOG.json",
        "host skill roots"
      ],
      "projections": [
        "scripts/collect-host-skill-evidence.ps1"
      ],
      "rule": "discovery evidence only; never claims behavioural correctness"
    },
    {
      "id": "validation-gate",
      "writes": [
        "review-finding-acceptance",
        "test-verdict",
        "validation-gate-decision"
      ],
      "rule": "duplicateGroups[review-and-test] 的裁决 owner；专项 review/test 方法只回 findings/results，最终验收门归 Sliver。"
    },
    {
      "id": "bug-rescue",
      "writes": [
        "bug-rescue-arbitration"
      ],
      "rule": "duplicateGroups[bug-rescue] 的裁决 owner；bug-fixer 与 diagnosing-bugs 均不得改写 route/depth/truth。"
    },
    {
      "id": "ui-quality",
      "writes": [
        "ui-quality-arbitration"
      ],
      "rule": "duplicateGroups[ui-quality] 的裁决 owner；UI 原技能独立，profile 只组合调用，不复制正文、不产生第二套设计真源。"
    },
    {
      "id": "context-handoff",
      "writes": [
        "context-handoff-arbitration"
      ],
      "rule": "duplicateGroups[context-and-handoff] 的裁决 owner；交接产物不拥有 target-truth。"
    },
    {
      "id": "doc-authoring",
      "writes": [
        "doc-authoring-arbitration"
      ],
      "rule": "duplicateGroups[doc-authoring] 的裁决 owner；文档同步不得覆盖 target-truth。"
    },
    {
      "id": "architecture",
      "writes": [
        "architecture-arbitration"
      ],
      "rule": "duplicateGroups[architecture] 的裁决 owner；架构产物不拥有 route 或第二份真源。"
    },
    {
      "id": "git-release",
      "writes": [
        "git-release-arbitration"
      ],
      "rule": "duplicateGroups[git-and-release] 的裁决 owner；发布授权与验收门仍归 Sliver。"
    }
  ],
  "forbidden": [
    "duplicate project-level router",
    "manual generated mirror edits",
    "parallel truth authorities",
    "untracked hook writers"
  ]
}
