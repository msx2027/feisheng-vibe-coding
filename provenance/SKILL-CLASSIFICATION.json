{
  "schema": "feisheng-skill-classification/v1",
  "owner": "skill-catalog",
  "status": "active",
  "note": "分类唯一真源。build-canonical-catalog.ps1 只从本文件 + SKILL-INVENTORY.json 派生 CANONICAL-CATALOG.json；改分类 = 改本文件，不再改 PowerShell 数组。domain 与 readiness 是正交两轴，status 由 statusPolicy 派生。 status 是给消费者的兼容别名（generated alias）；未来收敛阶段消费者应直接读 readiness，status 可移除。accepted 只对 primitive 域开放策略行：把非 primitive 域提升为运行时是一笔需要显式决策的动作，故意保持 fail-closed。",
  "runtimePolicy": {
    "controlPlaneStatus": "control-plane",
    "acceptedStatuses": [
      "control-plane",
      "accepted-primitive"
    ],
    "note": "只有 acceptedStatuses 可进入 runtime 投影；其余一律 runtime-excluded（fail-closed）"
  },
  "statusPolicy": {
    "adapter|candidate": "adapter-candidate",
    "alias|compatibility": "compatibility-alias",
    "checker|blocked": "blocked-unclassified-working-tree",
    "checker|candidate": "adapter-candidate",
    "checker|source-only": "source-only-checker",
    "control-plane|runtime": "control-plane",
    "event|candidate": "adapter-candidate",
    "event|source-only": "event-only-source-only",
    "in-progress|excluded": "excluded-in-progress",
    "primitive|accepted": "accepted-primitive",
    "primitive|blocked": "blocked-unclassified-working-tree",
    "primitive|candidate": "adapter-candidate",
    "primitive|source-only": "source-only-primitive",
    "product-or-checker|candidate": "adapter-candidate",
    "product-or-checker|source-only": "source-only-product-or-checker",
    "selector|compatibility": "compatibility-selector",
    "ui|candidate": "adapter-candidate",
    "ui|source-only": "source-only-ui",
    "unreviewed|candidate": "adapter-candidate",
    "unreviewed|source-only": "source-only-unreviewed",
    "user-tool|candidate": "adapter-candidate",
    "user-tool|source-only": "source-only-user-tool"
  },
  "reasonsByStatus": {
    "accepted-primitive": "已验收工程原语；进入 runtime 静态投影",
    "adapter-candidate": "已审查、待适配器与行为 smoke；未进入 runtime",
    "blocked-unclassified-working-tree": "来源工作树半改名且未提交，未获上游/维护者确认",
    "compatibility-alias": "兼容入口别名；不得拥有项目级路由",
    "compatibility-selector": "兼容选择器；不得拥有项目级路由",
    "control-plane": "唯一项目级控制面（Sliver）",
    "event-only-source-only": "仅限结构化事件调用；需宿主事件契约与独立审查",
    "excluded-in-progress": "上游 in-progress；不进入正式运行包",
    "source-only-checker": "专项 checker；Sliver 拥有验收门，未进入 runtime",
    "source-only-primitive": "来源专用工程原语；未验收",
    "source-only-product-or-checker": "产品/checker 来源专用；逐技能审计与许可证映射已完成，待宿主行为 smoke",
    "source-only-ui": "UI 来源专用；许可证台账已合并，待宿主行为 smoke",
    "source-only-unreviewed": "尚未完成语义审查",
    "source-only-user-tool": "用户显式工具；未做宿主行为 smoke"
  },
  "reasonsById": {
    "ui-styling": "许可证缺口（IBMPlexSerif/InstrumentSerif OFL）已补齐，映射见 legal/fonts/NOTICE.md；仍待宿主行为 smoke",
