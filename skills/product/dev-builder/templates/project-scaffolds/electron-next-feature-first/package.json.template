{
  "name": "__NPM_PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "main": ".electron-dist/main.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "next dev",
    "dev:desktop": "npm run build:electron && electron .electron-dist/main.js",
    "check:docs": "node -e \"const run=(p,...a)=>{if(!require('fs').existsSync(p)){console.log('[skip] '+p+' 未随本包脚手架分发');return}try{require('child_process').execFileSync('node',[p,...a],{stdio:'inherit'})}catch(e){process.exit(typeof e.status==='number'?e.status:1)}};run('tools/build-target-doc-index.mjs','.','--check');run('tools/check-target-doc-drift.mjs','.','--quick','--strict');run('tools/check-lifecycle-doc-budget.mjs','.','--strict')\"",
    "check:health": "npm run check:docs && node -e \"const p='tools/vibe-health-check.mjs';((p,...a)=>{if(!require('fs').existsSync(p)){console.log('[skip] '+p+' 未随本包脚手架分发');return}try{require('child_process').execFileSync('node',[p,...a],{stdio:'inherit'})}catch(e){process.exit(typeof e.status==='number'?e.status:1)}})(p,'.','--profile','target','--level','quick')\"",
    "check:api-contracts": "node -e \"const p='tools/check-api-contracts.mjs';((p,...a)=>{if(!require('fs').existsSync(p)){console.log('[skip] '+p+' 未随本包脚手架分发');return}try{require('child_process').execFileSync('node',[p,...a],{stdio:'inherit'})}catch(e){process.exit(typeof e.status==='number'?e.status:1)}})(p,'.')\"",
    "check:hotspots": "node tools/check-hotspots.mjs .",
    "check:runtime-sync": "node -e \"const p='tools/check-runtime-sync.mjs';((p,...a)=>{if(!require('fs').existsSync(p)){console.log('[skip] '+p+' 未随本包脚手架分发');return}try{require('child_process').execFileSync('node',[p,...a],{stdio:'inherit'})}catch(e){process.exit(typeof e.status==='number'?e.status:1)}})(p,'.')\"",
    "check:ui-reuse": "node -e \"const p='tools/check-ui-reuse.mjs';((p,...a)=>{if(!require('fs').existsSync(p)){console.log('[skip] '+p+' 未随本包脚手架分发');return}try{require('child_process').execFileSync('node',[p,...a],{stdio:'inherit'})}catch(e){process.exit(typeof e.status==='number'?e.status:1)}})(p,'.','--all')\"",
    "build": "npm run check:health && next build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "prepare:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "electron": "43.4.0",
    "next": "15.5.21",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "nanoid": "3.3.18"
  }
}
