{
  "evaluation_scope": "route_contract_corpus_only",
  "requires_live_model_validation": true,
  "route_projection_contract": {
    "owner_file": "references/routes-index.md",
    "catalog_schema": "sliver-route-catalog/v1",
    "projection_schema": "sliver-route-projection/v1",
    "lens_catalog_schema": "sliver-lens-catalog/v1",
    "lens_projection_schema": "sliver-lens-projection/v1",
    "exact_purpose_cell": true,
    "exact_load_cell": true,
    "measure_actual_json_bytes": true,
    "independent_oracle_required": true
  },
  "question_contract": {
    "owner_file": "references/question-bank.md",
    "required_terms": [
      "Ask at most 1-3 blocking questions at a time",
      "Never ask a question whose answer is already discoverable",
      "The AI decides whether durable truth, design tokens, architecture documentation, official-document research, and a validation method are required",
      "ask exactly one unresolved blocking product fact at a time"
    ],
    "forbidden_patterns": [
      "Ask 3-5 blocking questions",
      "是否需要我先起草实施真源",
      "是否允许我先定义一套最小 design tokens",
      "是否允许我查官方 API 文档",
      "你希望我用截图.*运行命令来证明"
    ]
  },
  "required_skill_contract_terms": [
    "This skill is the single top-level owner for AI-assisted software-project advancement",
    "smallest useful current truth",
    "Select exactly one primary route",
    "zero or more evidence-backed conditional lenses",
    "Collect fresh verification",
    "does not force every task through the full lifecycle",
    "not a substring classifier",
    "Any request to add, remove, modify, fix, refactor, connect, configure, or continue project behavior",
    "A clear first-time error, compiler/test failure, or local bug uses `开发执行`",
    "keep `开发执行` primary and load the relevant conditional lenses",
    "A product action described as \"用户提交资料\" is normal `开发执行`, not Git work",
    "Route names are stable internal identifiers, not commands, user-facing syntax, or literal trigger terms",
    "They are not user routes, alternate entry points, or keyword triggers"
  ],
  "forbidden_primary_route_labels": [
    "任务风险分级",
    "功能开工评估",
    "收费权益设计",
    "第三方接入",
    "接口安全",
    "配置安全",
    "执行子阶段"
  ],
  "expected_lens_impacts": {
    "frontend-design": "Analysis, audit, explanation, recommendation, design, implementation, or validation of a user-visible interaction, journey, layout, navigation, responsive state, accessibility, design-system owner, UI prototype, or design-to-code result.",
    "data-model": "Stored objects, fields, relationships, status, migration, transaction, audit, or retention rules change.",
    "backend-api": "Business rules, service ownership, API contracts, jobs, callbacks, or server-side enforcement change.",
    "identity-permission": "Login, roles, visibility, ownership, admin behavior, cross-user access, or allowed actions change.",
    "monetization-entitlement": "Money, paid value, plan, order, subscription, entitlement, paid quota, refund, cancel, expiry, invoice, or paid access changes.",
    "third-party-provider": "The chosen design depends on an external API, SDK, OAuth flow, webhook, payment provider, map, AI, storage, messaging, analytics, app store, or cloud capability.",
    "security-impact": "Identity, permission, ownership, untrusted input, sensitive data, writes, secrets, uploads, public exposure, resource limits, or release settings may change.",
    "deployment-release": "Runtime topology, environment, jobs, domain, public/private exposure, migration, rollback, monitoring, quota, or production cost may change."
  },
  "forbidden_lens_impact_patterns": [
    "\\b(apply|run|load|use)\\b.{0,40}\\b(each|every|all|any)\\b.{0,30}\\b(change|task|request|development)\\b",
    "\\b(each|every|all|any)\\b.{0,30}\\b(change|task|request|development)\\b.{0,40}\\b(apply|run|load|use)\\b",
    "(每次|每个|任何|所有|全部).{0,20}(改动|任务|请求|开发).{0,20}(执行|应用|加载|使用)",
    "mandatory by default|default mandatory|always mandatory|默认(必须|强制|执行|加载|应用)"
  ],
  "forbidden_competing_entry_patterns": [
    "(separate|independent|alternate|parallel|competing).{0,60}(user )?(route|entry|workflow)",
    "(单独|独立|并列|平行|竞争).{0,30}(用户)?(入口|路由|流程)",
    "(use|run|enter|start).{0,100}(first|before).{0,100}(then|continue).{0,100}(normal development|开发执行|development)",
    "(先|优先).{0,80}(再|然后).{0,80}(开发执行|正常开发|继续开发)"
  ],
