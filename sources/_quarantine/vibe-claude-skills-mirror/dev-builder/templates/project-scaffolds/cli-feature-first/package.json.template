{
  "name": "__NPM_PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "__NPM_PACKAGE_NAME__": "src/index.mjs"
  },
  "scripts": {
    "dev": "node src/index.mjs --help",
    "check:docs": "node tools/build-target-doc-index.mjs . --check && node tools/check-target-doc-drift.mjs . --quick --strict && node tools/check-lifecycle-doc-budget.mjs . --strict",
