:root {
  --vibe-ui-color-page: #f7f8fb;
  --vibe-ui-color-surface: #ffffff;
  --vibe-ui-color-text: #151923;
  --vibe-ui-color-muted: #5f6877;
  --vibe-ui-color-border: #d8dde7;
  --vibe-ui-color-primary: #2563eb;
  --vibe-ui-color-primary-strong: #1d4ed8;
  --vibe-ui-radius-card: 8px;
  --vibe-ui-radius-control: 8px;
  --vibe-ui-shadow-card: 0 16px 48px rgb(15 23 42 / 0.12);
  --vibe-ui-space-3: 0.75rem;
  --vibe-ui-space-4: 1rem;
  --vibe-ui-space-6: 1.5rem;
}

html,
body {
  min-height: 100%;
  margin: 0;
  background: var(--vibe-ui-color-page);
  color: var(--vibe-ui-color-text);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
}

* {
  box-sizing: border-box;
}

.vibe-ui-card {
  border: 1px solid var(--vibe-ui-color-border);
  border-radius: var(--vibe-ui-radius-card);
  background: var(--vibe-ui-color-surface);
  box-shadow: var(--vibe-ui-shadow-card);
  padding: var(--vibe-ui-space-6);
}

.vibe-ui-button {
  min-height: 2.5rem;
  border: 0;
  border-radius: var(--vibe-ui-radius-control);
  background: var(--vibe-ui-color-primary);
  color: var(--vibe-ui-color-surface);
  cursor: pointer;
  font: inherit;
  font-weight: 650;
  padding: 0 var(--vibe-ui-space-4);
}

.vibe-ui-button:hover {
  background: var(--vibe-ui-color-primary-strong);
}

.vibe-ui-button:disabled {
  cursor: not-allowed;
  opacity: 0.56;
}
